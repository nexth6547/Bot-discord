# ===================================================
# CONFIGURATION DISCORD BOT & DASHBOARD (DraftBot-like)
# ===================================================

# 1. Identifiants Discord (Disponibles sur https://discord.com/developers/applications)
# Créez une application, allez dans "Bot" pour générer le Token, et "OAuth2" pour Client ID & Secret
DISCORD_TOKEN="VOTRE_TOKEN_BOT_DISCORD"
DISCORD_CLIENT_ID="VOTRE_CLIENT_ID"
NEXT_PUBLIC_DISCORD_CLIENT_ID="VOTRE_CLIENT_ID"
DISCORD_CLIENT_SECRET="VOTRE_CLIENT_SECRET"

# 2. Configuration Dashboard Web
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="une_cle_secrete_aleatoire_tres_longue_min_32_caracteres"
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/callback/discord"

# 3. Base de Données (SQLite locale par défaut)
DATABASE_URL="file:../../dev.db"

# 4. Paramètres par défaut du bot
DEFAULT_PREFIX="!"
PORT=3000
